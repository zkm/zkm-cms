# Production settings for zkm-cms. Copy to .env on the server (chmod 640, owned by root:apache).
CI_ENVIRONMENT = production

app.baseURL = 'https://www.zachschneider.com/'
app.forceGlobalSecureRequests = true

# Admins must use an authenticator code (default in production). Only turn off to recover access.
# admin.requireTotp = false

# Who may reach /admin at all. Either or both; anyone else gets a 404. See docs/MIGRATION.md.
# admin.allowedIps = '203.0.113.7, 2001:db8::/48'
# admin.accessTeam = 'your-team'
# admin.accessAud = '<Application Audience (AUD) tag>'
# admin.accessEmails = 'me@example.com'

# php spark key:generate writes this line
encryption.key =

database.default.hostname = localhost
database.default.database = zkm
database.default.username = zkm
database.default.password =

# Only while importing: a read-only MariaDB user on the WordPress database.
# database.wordpress.hostname = localhost
# database.wordpress.database = wordpress
# database.wordpress.username = zkm_wp_ro
# database.wordpress.password =

cache.handler = redis
cache.redis.host = 127.0.0.1

session.savePath = /var/lib/zkm-cms/sessions
cookie.secure = true

# Proton SMTP (the same account WP Mail SMTP uses today)
email.protocol = smtp
email.SMTPHost = smtp.protonmail.ch
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPUser = me@zachschneider.com
email.SMTPPass =
email.fromEmail = me@zachschneider.com
